# ---------------------------------------------------------------------------
# Kustaro environment variables
# Copy this file to `.env.local` and fill in the values you have.
# The app runs out-of-the-box with AI_PROVIDER=mock and the local seed
# tariff data. Supabase is required for auth + persistence.
# ---------------------------------------------------------------------------

# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider selection: mock | openai | anthropic | gemini | groq | openrouter | cerebras
# `mock` works with no API keys and is fully deterministic for demos/tests.
# `gemini` is the free-tier option: get a key at https://aistudio.google.com
# (no billing card required) and it enables real Google Search for Quick Find.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Free-tier FALLBACK chain (all optional). If the primary provider above hits
# its rate limit / quota or has an outage, requests automatically fall back to
# these in order: Groq -> OpenRouter -> Cerebras -> offline engine. Any that
# has a key joins the chain; users see a service notice when a fallback served
# their result. Keys are free at:
#   Groq       https://console.groq.com
#   OpenRouter https://openrouter.ai/keys  (use a `:free` model)
#   Cerebras   https://cloud.cerebras.ai
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CEREBRAS_MODEL=llama-3.3-70b

# Optional: model used only for Quick Find's web-searchable lookups
# (Anthropic uses its web_search tool and Gemini uses googleSearch grounding
# automatically with their main model — no separate model needed there).
OPENAI_SEARCH_MODEL=gpt-4o-search-preview

# Live tariff data (optional). `seed` (default) uses the offline reference
# dataset. `live` fetches real MFN duty rates from free government APIs — the
# UK Trade Tariff API for GB destinations and the USITC HTS for US — with
# automatic fallback to the seed data on any failure. No API keys needed.
TARIFF_DATA_SOURCE=seed

# Secret for the scheduled tariff-refresh cron (/api/cron/refresh-tariffs).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. If unset, the
# route is unauthenticated (fine for local dev; set it in production).
CRON_SECRET=

# Optional: a JSON file you host with updated trade-war tariff rates. Merged
# (by id) over the built-in reference dataset so you can bump US Section 301/
# reciprocal rates without a code change. Refreshed by the cron above. See
# docs/trade-remedies.override.example.json for the format.
TRADE_REMEDY_OVERRIDE_URL=

# ---------------------------------------------------------------------------
# Payments. PAYMENT_PROVIDER selects the active provider:
#   paddle  -> Paddle, merchant of record — sells worldwide, handles VAT, and
#              pays out to a personal bank account (no registered company
#              needed, works from Türkiye) — active now
#   stripe  -> for the future EU move
#   (unset) -> auto: paddle if configured, else stripe, else mock
# With no provider configured the app stays in "mock" mode (plan changes apply
# directly, for demos/local dev).
PAYMENT_PROVIDER=paddle

# Paddle. Sign up as an INDIVIDUAL at https://paddle.com (sandbox first at
# https://sandbox-vendors.paddle.com). In the dashboard create one Product
# with a monthly recurring Price per paid tier and paste the price ids below.
#   Client token:   Developer tools -> Authentication -> client-side tokens
#   API key:        Developer tools -> Authentication -> API keys
#   Webhook secret: Developer tools -> Notifications -> add a destination
#                   pointing at  https://<your-site>/api/paddle/webhook
#                   subscribed to the subscription.* events
# Sandbox credentials (test_... / pdl_sdmy_...) are auto-detected; set
# PADDLE_ENV=production|sandbox to override.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PRO=
PADDLE_PRICE_BUSINESS=

# Stripe (future / EU). Recurring price IDs come from your Stripe products.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Operator notifications. RESEND_API_KEY lets the app send transactional email
# (e.g. an alert when a customer submits broker feedback) from the verified
# domain. Auth emails are sent separately by Supabase over SMTP.
#   RESEND_API_KEY   re_...  (https://resend.com/api-keys)
#   EMAIL_FROM       overrides the default "Kustaro <no-reply@kustaro.app>"
#   ADMIN_EMAILS     comma-separated operator allowlist for /dashboard/admin/*
#                    and feedback alerts; defaults to the two co-founders.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAILS=
