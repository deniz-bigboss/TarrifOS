# ---------------------------------------------------------------------------
# TariffOS environment variables
# Copy this file to `.env.local` and fill in the values you have.
# The app runs out-of-the-box with AI_PROVIDER=mock and the local seed
# tariff data. Supabase is required for auth + persistence.
# ---------------------------------------------------------------------------

# Supabase (https://app.supabase.com -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider selection: mock | openai | anthropic | gemini | groq | openrouter | cerebras
# `mock` works with no API keys and is fully deterministic for demos/tests.
# `gemini` is the free-tier option: get a key at https://aistudio.google.com
# (no billing card required) and it enables real Google Search for Quick Find.
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Free-tier FALLBACK chain (all optional). If the primary provider above hits
# its rate limit / quota or has an outage, requests automatically fall back to
# these in order: Groq -> OpenRouter -> Cerebras -> offline engine. Any that
# has a key joins the chain; users see a service notice when a fallback served
# their result. Keys are free at:
#   Groq       https://console.groq.com
#   OpenRouter https://openrouter.ai/keys  (use a `:free` model)
#   Cerebras   https://cloud.cerebras.ai
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CEREBRAS_MODEL=llama-3.3-70b

# Optional: model used only for Quick Find's web-searchable lookups
# (Anthropic uses its web_search tool and Gemini uses googleSearch grounding
# automatically with their main model — no separate model needed there).
OPENAI_SEARCH_MODEL=gpt-4o-search-preview

# Live tariff data (optional). `seed` (default) uses the offline reference
# dataset. `live` fetches real MFN duty rates from free government APIs — the
# UK Trade Tariff API for GB destinations and the USITC HTS for US — with
# automatic fallback to the seed data on any failure. No API keys needed.
TARIFF_DATA_SOURCE=seed

# Secret for the scheduled tariff-refresh cron (/api/cron/refresh-tariffs).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`. If unset, the
# route is unauthenticated (fine for local dev; set it in production).
CRON_SECRET=

# Stripe (optional — billing is a placeholder unless these are present)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Public site URL (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
